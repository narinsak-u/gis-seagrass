# Development-only database credentials; override privately in .env.
DB_USER=seagrass
DB_PASSWORD=seagrass_dev_only
DB_NAME=seagrass

# Development-only token signing secret; replace in deployments.
JWT_SECRET=development-only-change-this-signing-secret-32-bytes

# Published host ports and bind address.
DB_PORT=5432
API_PORT=3000
WEB_PORT=3001
BIND_HOST=127.0.0.1

# Optional integration-test database; use a separate disposable PostGIS instance.
IMPORT_TEST_DATABASE_URL=postgresql://seagrass_test:seagrass_test_only@127.0.0.1:55432/seagrass_test
